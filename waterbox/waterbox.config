{
  "coreName": "UnrealSpeccyP",
  "systemId": "ZXS",
  "deterministic": true,
  "romFile": "core.wbx",
  "abi": 1,
  "memoryLayoutMiB": [
    16,
    16,
    64,
    64,
    512
  ],
  "video": {
    "width": 320,
    "height": 240,
    "getBgra": "GetVideoBgra",
    "vsyncNumerator": 50,
    "vsyncDenominator": 1
  },
  "audio": {
    "get": "GetAudio",
    "samplesPerFrame": 882,
    "channels": 2
  },
  "input": {
    "name": "ZX Spectrum",
    "buttons": [
      "Kempston.Up",
      "Kempston.Down",
      "Kempston.Left",
      "Kempston.Right",
      "Kempston.Fire",
      "Sinclair.Up",
      "Sinclair.Down",
      "Sinclair.Left",
      "Sinclair.Right",
      "Sinclair.Fire",
      "Cursor.Up",
      "Cursor.Down",
      "Cursor.Left",
      "Cursor.Right",
      "Cursor.Fire",
      "QAOP.Up",
      "QAOP.Down",
      "QAOP.Left",
      "QAOP.Right",
      "QAOP.Fire",
      "Key.Space",
      "Key.Enter"
    ],
    "mnemonics": {
      "Kempston.Up": "U",
      "Kempston.Down": "D",
      "Kempston.Left": "L",
      "Kempston.Right": "R",
      "Kempston.Fire": "F",
      "Sinclair.Up": "u",
      "Sinclair.Down": "d",
      "Sinclair.Left": "l",
      "Sinclair.Right": "r",
      "Sinclair.Fire": "f",
      "Cursor.Up": "^",
      "Cursor.Down": "v",
      "Cursor.Left": "<",
      "Cursor.Right": ">",
      "Cursor.Fire": "*",
      "QAOP.Up": "Q",
      "QAOP.Down": "A",
      "QAOP.Left": "O",
      "QAOP.Right": "P",
      "QAOP.Fire": "M",
      "Key.Space": "S",
      "Key.Enter": "E"
    }
  },
  "settings": [
    {
      "name": "mode48k",
      "display": "48K mode",
      "description": "Boot the 48K ROM instead of 128K (Pentagon timings stay). Shapes the machine, so it is a sync setting.",
      "type": "bool",
      "default": false
    },
    {
      "name": "fastTape",
      "display": "Fast tape loading",
      "description": "Trap the ROM tape loader (dec/djnz delay loops and edge waits) instead of executing it, while a tape runs. Upstream default; off is cycle-exact loading. Shapes the machine, so it is a sync setting.",
      "type": "bool",
      "default": true
    },
    {
      "name": "soundChip",
      "display": "Sound chip",
      "description": "AY-3-8910 or its Yamaha YM2149F pin-compatible follow-up (different volume tables). Shapes the machine, so it is a sync setting.",
      "type": "enum",
      "options": [
        "ay",
        "ym"
      ],
      "optionLabels": {
        "ay": "AY-3-8910",
        "ym": "YM2149F"
      },
      "default": "ay"
    }
  ],
  "firmware": [
    {
      "id": "sos128_0.rom",
      "description": "Pentagon 128K BASIC ROM (page 0). The machine does not boot without it.",
      "size": 16384,
      "sha1": "80080644289ED93B7103992A154CC9802B2FA"
    },
    {
      "id": "sos128_1.rom",
      "description": "Pentagon 128K editor/menu ROM (page 1). The machine does not boot without it.",
      "size": 16384,
      "sha1": "D07FCDECA892EE80449D286EA5BF3928A1ACA"
    },
    {
      "id": "sos48.rom",
      "description": "48K BASIC ROM, selected at boot when mode48k is on (always loaded; the machine exits without any of the five).",
      "size": 16384,
      "sha1": "5EA7C2B824672E914525D1D5B419D84A426A2"
    },
    {
      "id": "service.rom",
      "description": "Service/test ROM, selected at boot when not in 48K mode. The machine does not boot without it.",
      "size": 16384,
      "sha1": "5F40F5AF51C4C38AC095349D7518545B0E0"
    },
    {
      "id": "dos513f.rom",
      "description": "TR-DOS ROM for the Beta Disk interface. Needed for disk images.",
      "size": 16384,
      "sha1": "5C14C0C389E29521CB59672F8A74E0184C9"
    }
  ]
}
