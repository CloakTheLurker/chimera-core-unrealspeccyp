{
  "_comment": "DRAFT (M0). Machine: Pentagon 128K ZX-Spectrum. systemId ZXS matches chimera's ares row. vsync 50/1 here AND in wbx-entry GetVsyncNumerator/Denominator. memoryLayoutMiB is {sbrk, sealed, invisible, plain, mmap} — M2 grows the MMAP arena, not sbrk. Buttons/firmware to confirm against a booted machine. version/versionDate are stamped by build-package.sh, never hand-written.",
  "coreName": "UnrealSpeccyP",
  "systemId": "ZXS",
  "deterministic": true,
  "romFile": "core.wbx",
  "memoryLayoutMiB": [16, 16, 64, 64, 512],
  "video": {
    "width": 320,
    "height": 240,
    "getBgra": "GetVideoBgra",
    "vsyncNumerator": 50,
    "vsyncDenominator": 1
  },
  "audio": {
    "get": "GetAudio",
    "samplesPerFrame": 882,
    "channels": 2
  },
  "input": {
    "name": "ZX Spectrum",
    "buttons": [
      "Kempston.Up", "Kempston.Down", "Kempston.Left", "Kempston.Right", "Kempston.Fire",
      "Sinclair1.Up", "Sinclair1.Down", "Sinclair1.Left", "Sinclair1.Right", "Sinclair1.Fire",
      "Sinclair2.Up", "Sinclair2.Down", "Sinclair2.Left", "Sinclair2.Right", "Sinclair2.Fire",
      "Key.Q", "Key.A", "Key.O", "Key.P", "Key.M", "Key.Space"
    ]
  },
  "settings": [
    {"name": "mode48k", "default": false},
    {"name": "fastTape", "default": true},
    {"name": "soundChip", "default": "ay"}
  ],
  "firmware": [
    {"id": "zx128.rom", "description": "ZX Spectrum 128K / Pentagon system ROM"}
  ]
}
